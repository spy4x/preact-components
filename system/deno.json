{
  "name": "@spy4x/preact-system",
  "version": "3.17.0",
  "exports": {
    ".": "./+index.ts",
    "./auth-form": "./auth-form.tsx",
    "./head": "./head.ts",
    "./seo-head": "./seo-head.tsx",
    "./sw-updater": "./sw-updater.tsx",
    "./calendar": "./calendar.tsx",
    "./site-header": "./site-header.tsx",
    "./shell": "./shell.tsx",
    "./rail-shell": "./rail-shell.tsx",
    "./state-init": "./state-init.tsx",
    "./boundary": "./boundary.ts",
    // The boundary as ready tests an app registers with its own test function; see the file.
    "./boundary-runner": "./boundary-runner.ts",
    // The Playwright options every app shares. It imports nothing, so no app resolves Playwright
    // through this package.
    "./playwright": "./playwright.ts",
    "./conflict-chooser": "./conflict-chooser.tsx",
    "./install-prompt": "./install-prompt.tsx",
    "./route-announcer": "./route-announcer.ts",
    "./sync-status": "./sync-status.tsx"
  },
  "imports": {
    // Fresh is pinned here and nowhere else, for one test file only: `seo-head.fresh.test.tsx`
    // renders `SEOHead` through Fresh's real `<Head>`, because how Fresh treats a head tag's `key`
    // (it prints it as `data-key` and dedupes head tags by it) exists nowhere but in Fresh. No
    // published file imports it; the test files are excluded from publishing below.
    "fresh": "jsr:@fresh/core@2.3.3"
  },
  "publish": {
    // Every `*.test.*` here renders to `preact-render-to-string` or drives Deno's fake timers; none
    // of it is reachable from `exports`, and none of it is anything a consumer runs.
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
