  "publish": {
    // This package's own `*.test.*` suites, none reachable from `exports`. A glob rather than a
    // per-file list: a hand-kept list has to be remembered on every new test file, and nothing
    // here would catch a forgotten entry — a new `*.test.tsx` would ship to JSR with the package.
    // `**/` because a bare `*.test.ts` matches this directory only: measured in `ui-guide/`, where
    // it shipped `sections/demo-decisions.test.ts`. Every package that publishes uses this pair.
    // `testdata/` holds the islands `island-bundle.test.ts` bundles and `page-at.ts`, which puts a
    // test on a page with a `location`; both are for tests alone.
    "exclude": ["**/*.test.ts", "**/*.test.tsx", "testdata/"]
  }
}
