{
  "name": "@preact-components/ui",
  "version": "0.1.0",
  "exports": {
    ".": "./+index.ts",
    "./avatar": "./avatar.tsx",
    "./badge": "./badge.tsx",
    "./button": "./button.tsx",
    "./card": "./card.tsx",
    "./checkbox": "./checkbox.tsx",
    "./confidence-meter": "./confidence-meter.tsx",
    "./confirm-dialog": "./confirm-dialog.tsx",
    "./copy-button": "./copy-button.tsx",
    "./copyable-text": "./copyable-text.tsx",
    "./combobox": "./combobox.tsx",
    "./data-table": "./data-table.tsx",
    "./date-range": "./date-range.ts",
    "./date-range-picker": "./date-range-picker.tsx",
    "./dropdown": "./dropdown.tsx",
    "./empty-state": "./empty-state.tsx",
    "./error-state": "./error-state.tsx",
    "./field": "./field.tsx",
    "./geo-button": "./geo-button.tsx",
    "./input": "./input.tsx",
    "./input-button": "./input-button.tsx",
    "./loading-screen": "./loading-screen.tsx",
    "./loading-skeleton": "./loading-skeleton.tsx",
    "./loading-spinner": "./loading-spinner.tsx",
    "./modal": "./modal.tsx",
    "./on-off-buttons": "./on-off-buttons.tsx",
    "./page-title": "./page-title.tsx",
    "./pagination": "./pagination.tsx",
    "./progress": "./progress.tsx",
    "./radio": "./radio.tsx",
    "./skeletons": "./skeletons.tsx",
    "./table": "./table.tsx",
    "./tabs": "./tabs.tsx",
    "./toastr": "./toastr.tsx",
    "./toggle-field": "./toggle-field.tsx",
    "./toggle-switch": "./toggle-switch.tsx",
    "./tooltip": "./tooltip.tsx"
  },
  "publish": {
    // This package's own `*.test.*` suites, none reachable from `exports`. A glob rather than a
    // per-file list: a hand-kept list has to be remembered on every new test file, and nothing
    // here would catch a forgotten entry — a new `*.test.tsx` would ship to JSR with the package.
    "exclude": ["*.test.ts", "*.test.tsx"]
  }
}
