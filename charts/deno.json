{
  "name": "@spy4x/preact-charts",
  "version": "0.1.4",
  "exports": {
    ".": "./+index.ts",
    "./bars": "./bars.tsx",
    "./colors": "./colors.ts",
    "./donut-chart": "./donut-chart.tsx",
    "./kpi": "./kpi.tsx",
    "./line-chart": "./line-chart.tsx",
    "./payload": "./payload.ts",
    "./scales": "./scales.ts",
    "./time-series": "./time-series.ts",
    "./use-in-view": "./use-in-view.ts"
  },
  "publish": {
    // `ticks.worker.ts` and `nice-scale.worker.ts` exist only so `scales.test.ts` can call `ticks`
    // and `niceScale` off the main thread with a deadline (see their own JSDoc) and are loaded by no
    // published module; the rest are this package's own `*.test.*` suites. None of it is reachable
    // from `exports`.
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "ticks.worker.ts",
      "nice-scale.worker.ts"
    ]
  }
}
