{
  "name": "@spy4x/preact-signals",
  "version": "13.6.0",
  "exports": {
    ".": "./+index.ts",
    "./build-model-store": "./build-model-store.ts",
    "./clipboard": "./clipboard.ts",
    "./install-prompt": "./install-prompt.ts",
    "./map-entry": "./map-entry.ts",
    "./now": "./now.ts",
    "./onboarding": "./onboarding.ts",
    "./online": "./online.ts",
    "./patch-signal": "./patch-signal.ts",
    "./push-subscription": "./push-subscription.ts",
    "./settings": "./settings.ts",
    "./theme": "./theme.ts",
    "./toast": "./toast.ts",
    "./types": "./types.ts",
    "./use-url-filters": "./use-url-filters.ts",
    "./i18n/ar": "./i18n/ar.ts",
    "./i18n/de": "./i18n/de.ts",
    "./i18n/en": "./i18n/en.ts",
    "./i18n/es": "./i18n/es.ts",
    "./i18n/fr": "./i18n/fr.ts",
    "./i18n/ja": "./i18n/ja.ts",
    "./i18n/pt-BR": "./i18n/pt-BR.ts",
    "./i18n/ru": "./i18n/ru.ts",
    "./i18n/zh-CN": "./i18n/zh-CN.ts"
  },
  "publish": {
    // This package's own `*.test.*` suites, none reachable from `exports`; see `ui/deno.json` for
    // why the glob starts with `**/`. The catalogs' lock files are for `deno task i18n:stamp` and
    // the catalog test only.
    "exclude": ["**/*.test.ts", "**/*.test.tsx", "i18n/*.lock"]
  }
}
