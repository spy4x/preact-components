{
  "name": "@preact-components/crud",
  "version": "0.1.0",
  "exports": {
    ".": "./+index.ts",
    "./association-editor": "./association-editor.tsx",
    "./crud-editor": "./crud-editor.tsx",
    "./crud-list": "./crud-list.tsx",
    "./deletion-validation": "./deletion-validation.tsx",
    "./field": "./field.tsx",
    "./search": "./search.ts",
    "./store": "./store.ts",
    "./time-ago": "./time-ago.ts",
    "./types": "./types.ts",
    "./validation": "./validation.ts"
  },
  "publish": {
    // `examples/` demonstrates the package against a real store, in prose the package README
    // links to, but it is not part of `exports` and a consumer imports none of it. The rest are
    // this package's own `*.test.*` suites, none reachable from `exports` either.
    "exclude": [
      "association-editor.test.tsx",
      "crud-editor.test.ts",
      "crud-list.test.tsx",
      "examples/",
      "field.test.tsx",
      "search.test.ts",
      "store.test.ts",
      "time-ago.test.ts",
      "validation.test.ts"
    ]
  }
}
