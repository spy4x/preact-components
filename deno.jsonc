{
  // Every package a parallel agent will add is listed here up front. Deno skips
  // workspace members whose directory does not exist yet (warning, exit 0), so a
  // package becomes a real member the moment its own `<pkg>/deno.json` lands.
  // That keeps this file untouched by every package PR — no shared-file conflicts.
  //
  // `./map` was listed on that basis and never arrived: `Map` is a recorded
  // "deliberately not built" entry (see `docs/not-building.md`), because it needs
  // Leaflet — a dependency decision nobody has taken. Dropped rather than kept as a
  // phantom, so `deno task check` stops printing `Workspace member "./map" not found`
  // on every invocation. Add it back together with the package, in one change.
  "workspace": [
    "./charts",
    "./cn",
    "./crud",
    "./icons",
    // Not a package: the GitHub Pages demo. It is a member so it can pin its own build-only
    // dependencies in `pages/deno.json` instead of adding them to the import map below.
    "./pages",
    "./signals",
    "./system",
    "./theme",
    "./ui",
    "./ui-guide"
  ],
  "tasks": {
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": ["fmt:check", "lint", "ts:check", "test"]
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "ts:check": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
    // Every test in the workspace reads its own sources; the theme package's
    // compile suites additionally read the Deno npm cache to run the real
    // Tailwind compiler (resolved via `import.meta.resolve`, so `HOME` is no
    // longer read). Both grants are as narrow as the tests allow, and are
    // repo-wide only because `deno test` discovers every member's suite in
    // one process. Nothing here needs `net`, `run` or `write`.
    "test": "deno test --no-prompt --allow-read --allow-env",
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": ["lint:fix", "fmt"]
    }
  },
  "imports": {
    // Preact + signals, pinned exactly. Whether these match `spy4x/template` and
    // `spy4x/ts-libs` is not checked by anything here — see AGENTS.md → Dependencies
    // for the grep that compares lockfiles by hand.
    "preact": "npm:preact@10.28.2",
    "preact/": "npm:/preact@10.28.2/",
    "@preact/signals": "npm:@preact/signals@2.5.1",
    "@preact/signals-core": "npm:@preact/signals-core@1.12.1",
    "wouter-preact": "npm:wouter-preact@3.9.0",

    // Stdlib
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/testing": "jsr:@std/testing@1.0.20",

    // Validation — arktype only, never zod
    "arktype": "npm:arktype@2.2.3",

    // Class name helper — see `cn/` for the small function built on it
    "tailwind-merge": "npm:tailwind-merge@3.7.0",

    // No d3 here on purpose. This map is ambient for every consumer of every package, and d3 is
    // used by exactly one module — `charts/d3-line-chart.tsx` — so the specifier lives in
    // `charts/deno.json` instead. `ui-guide/deno.json` declares it too, because the registry
    // type-checks that module through the barrel. A consumer that wants the interactive charts adds
    // d3 themselves; see `charts/README.md`.

    // Tailwind, pinned to the version spy4x/template builds with
    "tailwindcss": "npm:tailwindcss@4.1.12",
    "tailwindcss/": "npm:/tailwindcss@4.1.12/",
    "@tailwindcss/forms": "npm:@tailwindcss/forms@0.5.10"
  },
  "compilerOptions": {
    // An explicit "lib" replaces Deno's default lib set, so "deno.ns" has to be
    // listed back or `Deno.*` disappears from every repository script.
    "lib": ["ES2020", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [
    ".volumes",
    "**/coverage/*",
    "**/dist/*",
    "node_modules",
    "*.lock"
  ]
}
