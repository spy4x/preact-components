{
  // Every package a parallel agent will add is listed here up front. Deno skips
  // workspace members whose directory does not exist yet (warning, exit 0), so a
  // package becomes a real member the moment its own `<pkg>/deno.json` lands.
  // That keeps this file untouched by every package PR — no shared-file conflicts.
  //
  // `./map` sat here on that same basis for a while and never arrived — `Map` was a recorded
  // "deliberately not built" entry (see `docs/not-building.md`), because it needed Leaflet, a
  // dependency decision nobody had taken — and was dropped rather than kept as a phantom, so
  // `deno task check` stopped printing `Workspace member "./map" not found` on every invocation.
  // Issue #143 took that decision (Leaflet is one of the "keep" libraries in the owner's global
  // policy) and added the package back here, together with `map/deno.json`, in the same change.
  "workspace": [
    "./charts",
    "./cn",
    "./crud",
    "./icons",
    "./map",
    // Not a package: the GitHub Pages demo. It is a member so it can pin its own build-only
    // dependencies in `pages/deno.json` instead of adding them to the import map below.
    "./pages",
    "./signals",
    "./system",
    "./theme",
    "./ui",
    "./ui-guide"
  ],
  "tasks": {
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": ["fmt:check", "lint", "ts:check", "test"]
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "ts:check": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
    // Every test in the workspace reads its own sources; the theme package's
    // compile suites additionally read the Deno npm cache to run the real
    // Tailwind compiler (resolved via `import.meta.resolve`, so `HOME` is no
    // longer read). Both grants are as narrow as the tests allow, and are
    // repo-wide only because `deno test` discovers every member's suite in
    // one process. Nothing here needs `net`, `run` or `write` — see
    // `pages/build-fingerprint.ts`'s own doc for why its build-fingerprint logic is split into
    // pure functions the colocated test exercises with in-memory fixtures instead.
    "test": "deno test --no-prompt --allow-read --allow-env",
    // Dry-runs the publish for every named workspace member (`pages/` has no `name`, so `deno
    // publish` skips it on its own — nothing here excludes it by hand). Named `publish:dry`
    // rather than `publish`: this only ever simulates; the real `deno publish` runs in Woodpecker
    // on a `v*` tag (docs/publishing.md), and a bare `publish` task would read as the thing that
    // ships to JSR. Run as its own step in both CI systems — `.github/workflows/pages.yml` and
    // `.woodpecker.yml` — rather than folded into `check`: `deno publish --dry-run` refuses a
    // dirty tree, so adding it to `check` would fail every local run against uncommitted work.
    // Both CI checkouts are clean, so the step there runs this task bare, with no `--allow-dirty`.
    "publish:dry": "deno publish --dry-run",
    // Whole-word search for private application names across every file each published package
    // would upload to JSR. Not part of `check`: it needs a names file the owner keeps outside
    // this repository, given as the next argument, e.g. `deno task private-names /path/to/names.txt`.
    // See docs/pre-publish-checks.md.
    "private-names": "deno run --allow-read --allow-run=deno infra/scripts/private-names.ts",
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": ["lint:fix", "fmt"]
    }
  },
  "imports": {
    // Preact + signals, pinned exactly. Whether these match `spy4x/template` and
    // `spy4x/ts-libs` is not checked by anything here — see AGENTS.md → Dependencies
    // for the grep that compares lockfiles by hand.
    "preact": "npm:preact@10.29.8",
    "preact/": "npm:/preact@10.29.8/",
    "@preact/signals": "npm:@preact/signals@2.5.1",
    "@preact/signals-core": "npm:@preact/signals-core@1.12.1",
    "wouter-preact": "npm:wouter-preact@3.9.0",

    // Stdlib
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/testing": "jsr:@std/testing@1.0.20",

    // Validation — arktype only, never zod
    "arktype": "npm:arktype@2.2.3",

    // spy4x/ts-libs, one exact version for every package that imports it. Shared helpers live
    // there once and are imported, never copied (spy4x/ts-libs#69, #70, #72). The trailing-slash
    // entries map every subpath of a package (`@spy4x/platform/universal/csv`) to the same release;
    // `deno publish` rewrites each import to that exact `jsr:` version, so only a package that
    // imports one of these gains it as a dependency.
    "@spy4x/platform/": "jsr:/@spy4x/platform@1.3.0/",
    "@spy4x/time/": "jsr:/@spy4x/time@1.3.0/",
    "@spy4x/validation": "jsr:@spy4x/validation@1.3.0",
    "@spy4x/validation/": "jsr:/@spy4x/validation@1.3.0/",

    // Test-only HTML renderer every package's suite imports. One pin here (#133) replaces six
    // identical per-package copies that all resolved the same version. Unlike `d3` below, this is
    // safe to centralise: every import of it is in a `*.test.tsx` file or the unpublished `pages/`
    // demo, never in a package's `exports`, so no published package's consumer ever resolves this
    // specifier — moving it here adds nothing to what a consumer's own dependency graph pulls in.
    "preact-render-to-string": "npm:preact-render-to-string@6.7.0",

    // Class name helper — see `cn/` for the small function built on it
    "tailwind-merge": "npm:tailwind-merge@3.7.0",

    // No d3 here on purpose. This map is ambient for every consumer of every package, and d3 is
    // used by exactly one module — `charts/d3-line-chart.tsx` — so the specifier lives in
    // `charts/deno.json` instead, which is the config Deno resolves that file's own imports
    // through. No other member declares it: `ui-guide/` renders the d3 charts in its catalogue and
    // still type-checks and bundles with no d3 entry of its own. A consumer that wants the
    // interactive charts adds d3 themselves; see `charts/README.md`.

    // Tailwind, pinned to the version spy4x/template builds with
    "tailwindcss": "npm:tailwindcss@4.1.12",
    "tailwindcss/": "npm:/tailwindcss@4.1.12/"
  },
  "compilerOptions": {
    // An explicit "lib" replaces Deno's default lib set, so "deno.ns" has to be
    // listed back or `Deno.*` disappears from every repository script.
    "lib": ["ES2020", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [
    ".volumes",
    "**/coverage/*",
    "**/dist/*",
    "node_modules",
    "*.lock"
  ]
}
