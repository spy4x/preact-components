{
  "name": "@spy4x/preact-icons",
  "version": "3.15.2",
  "exports": {
    ".": "./+index.tsx"
  },
  "tasks": {
    // Compares every glyph against five npm icon packs (#111, #112, #233). The packs are pinned
    // inside `provenance.ts`, not in an `imports` block here: the task runner installs a member's
    // mapped npm packages before any task in it, so an `imports` entry made every `deno task check`
    // download all five (#467). Excluded from `deno task check` because it is a one-off audit, not a
    // regression gate — `provenance.test.ts` covers the normalisation logic there instead, without
    // touching the network. `--lock` keeps the packs' integrity hashes in `provenance.lock`: written
    // to the root `deno.lock`, they would put the packs back on the task runner's install list.
    "provenance": "deno run --lock=provenance.lock --allow-read --allow-net provenance.ts"
  },
  "publish": {
    // Nothing here is part of the public API. The two `check-readme` files audit README.md's
    // bookkeeping against a read-only sibling checkout outside this repository, which a published
    // consumer has no access to and no use for. `provenance.ts`/`provenance.test.ts` are the same
    // shape of thing for the icon packs: a dev-time audit script and its offline-safe tests,
    // neither reachable from `exports`.
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "check-readme.ts",
      "provenance.ts",
      "provenance.lock"
    ]
  }
}
