{
  "name": "@spy4x/preact-server",
  "version": "13.11.0",
  "exports": {
    // The server: the app, routes, page rendering and static files.
    ".": "./+index.ts",
    // The browser half: wakes a page's islands. Imports nothing of the server, so the client
    // bundle stays small.
    "./client": "./client.ts",
    // The build half: the Vite plugin. Build-time only.
    "./vite": "./vite.ts"
  },
  "publish": {
    // This package's own `*.test.*` suites, none reachable from `exports`; see `ui/deno.json` for
    // why the glob starts with `**/`.
    "exclude": ["**/*.test.ts", "**/*.test.tsx"]
  }
}
