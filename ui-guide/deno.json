{
  "name": "@preact-components/ui-guide",
  "version": "0.1.0",
  "exports": {
    ".": "./+index.tsx",
    "./registry": "./registry.ts",
    "./routes": "./routes.ts"
  },
  "imports": {
    // `coverage.ts` reads each package's `exports` out of its `deno.json`, and Deno writes those
    // configs with comments. Declared here rather than in the root map because nothing else in the
    // workspace parses a config, and `coverage.ts` is not one of this package's published exports.
    //
    // There is deliberately no `d3` entry. The charts section renders the d3 islands, but the only
    // module that imports d3 is `charts/d3-line-chart.tsx`, whose imports Deno resolves through
    // `charts/deno.json`. `deno task ts:check` and `deno task --cwd pages build` both pass with no
    // d3 declared here, so an entry would be a pin nothing reads.
    "@std/jsonc": "jsr:@std/jsonc@1.0.2"
  },
  "publish": {
    // `coverage.ts` is this repository's own consistency check (see the `imports` comment above: it
    // is "not one of this package's published exports") and its dynamic `import(href)` — needed to
    // read a sibling package's subpath modules by a computed URL — is exactly what
    // `unanalyzable-dynamic-import` warns about; a published consumer never reaches it. The rest are
    // this package's own `*.test.*` suites, none reachable from `exports`.
    "exclude": [
      "catalogue.test.tsx",
      "classes.test.tsx",
      "copy.test.tsx",
      "coverage.test.ts",
      "coverage.ts",
      "icons.test.tsx",
      "instructions.test.ts",
      "registry.test.ts",
      "routes.test.ts",
      "sections/demo-decisions.test.ts"
    ]
  }
}
