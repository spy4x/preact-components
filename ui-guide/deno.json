{
  "name": "@spy4x/preact-ui-guide",
  "version": "13.3.0",
  "exports": {
    ".": "./+index.tsx",
    "./registry": "./registry.ts",
    "./routes": "./routes.ts"
  },
  "publish": {
    // `coverage.ts` is this repository's own consistency check, not one of this package's published
    // exports, and its dynamic `import(href)` — needed to
    // read a sibling package's subpath modules by a computed URL — is exactly what
    // `unanalyzable-dynamic-import` warns about; a published consumer never reaches it. The rest are
    // this package's own `*.test.*` suites, none reachable from `exports`, matched by glob so a new
    // one needs no entry (see `ui/deno.json` for why the glob starts with `**/`).
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "coverage.ts",
      // `registry-props.test.ts`'s reader of `deno doc` output: a check of this repository, like
      // `coverage.ts`, importing the repository's scripts outside this package.
      "registry-props.ts",
      // `coverage.test.ts`'s fixture package: a barrel, a subpath component and three configs.
      "testdata/"
    ]
  }
}
